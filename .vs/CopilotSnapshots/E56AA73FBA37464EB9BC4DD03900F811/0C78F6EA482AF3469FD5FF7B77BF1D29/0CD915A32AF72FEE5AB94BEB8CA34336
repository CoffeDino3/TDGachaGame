        private void DrawHotbarSlots(Graphics g, int barY)
        {
            int panelWidth = gamePanel.ClientSize.Width;

            const int slotSize = 52;
            const int slotGap = 8;
            int totalWidth = HotbarSlotCount * slotSize + (HotbarSlotCount - 1) * slotGap;
