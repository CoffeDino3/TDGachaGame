        private float IconScaleFactor()
        {
            // 900x700 is the window's starting size — the baseline the icon sizes below
            // were designed at. Icons grow with the window but never shrink past that,
            // and growth is capped so they don't get absurd on a huge monitor.
            int panelWidth = gamePanel.ClientSize.Width;
            int panelHeight = gamePanel.ClientSize.Height;
            float scale = Math.Min(panelWidth / 900f, panelHeight / 700f);
            return Math.Max(1f, Math.Min(2f, scale));
        }

