            using (var emptyBrush = new SolidBrush(Color.FromArgb(90, 255, 255, 255)))
            using (var emptyPen = new Pen(Color.Gainsboro, 1.5f))
            using (var selectedPen = new Pen(Color.Gold, 2.5f))
