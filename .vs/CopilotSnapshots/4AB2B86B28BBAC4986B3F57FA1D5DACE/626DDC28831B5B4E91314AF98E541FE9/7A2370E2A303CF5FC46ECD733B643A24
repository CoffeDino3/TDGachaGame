using System;
using System.Collections.Generic;

namespace TDGachaGame
{
    // One purchasable rung on a (shape, color) combo's upgrade ladder. Index 0 in a
    // ladder is always the free, un-upgraded "Level 1" baseline (Cost = 0) —
    // everything after that is something the player can buy with TryUpgradeShape.
    // Ladders are NOT the same length for every combo on purpose (some are simple
    // and shallow, others have a lot of room to grow) and they don't all grow the
    // same stats: SpecialValue / SpecialValue2 / CorridorWidthBonus / BlastRadiusMultiplier
    // mean different things depending on the shape+color (see the field comments and
    // TowerUpgradeConfig.Tiers).
    public class TowerUpgradeTier
    {
        public int Level;
        public int Cost;
        public float DamageMultiplier = 1f;
        public float RangeMultiplier = 1f;
        public float AttackIntervalMultiplier = 1f;

        // Meaning depends on shape+color:
        //   Purple -> stun duration (seconds)
        //   Green  -> poison damage-per-second
        //   Black (Triangle/Line) -> slow strength, as a speed multiplier (lower = stronger slow)
        //   Black (Square) -> same slow strength, applied to the whole blast
        //   White  -> ally buff duration (seconds) -- attack-speed buff for Triangle,
        //             damage buff for Square/Line
        //   Cyan (Square) -> knockback distance (tiles)
        //   everyone else -> unused (0)
        public float SpecialValue;

        // Meaning depends on shape+color:
        //   Green  -> poison duration (seconds)
        //   Black  -> slow duration (seconds)
        //   White  -> ally buff multiplier (attack-speed x for Triangle, damage x for Square/Line)
        //   everyone else -> unused (0)
        public float SpecialValue2;

        // Extra half-width added to the beam's hit corridor (Triangle only -- see
        // TowerManager.FindEnemiesAlongLineToward) — widens how many enemies a single
        // beam can clip on its way through, on top of the color's baseline corridor.
        public float CorridorWidthBonus;

        // Capstone perk: how many EXTRA beams/blasts (on top of the normal one) this
        // tier fires in the same attack, each at a different enemy. For Triangle this
        // means extra beams (see TowerManager.TryFireTriangle); for Square's Black
        // this means extra chained blasts on other nearby enemies (see
        // TowerManager.TryFireSquare). 0 = just the normal single hit.
        public int ExtraBeamCount;

        // Capstone perk: when > 0, a White tower's buff pulse also grants allies an
        // attack damage buff (multiplier applied on top of any speed buff) alongside
        // the usual effect, for the same duration. 0 = no damage buff yet.
        public float DamageBuffMultiplier;

        // Square only: multiplies the color's baseline blast radius (see
        // TowerManager.ApplySquareBlast) -- everyone else leaves this at 1f.
        public float BlastRadiusMultiplier = 1f;
    }

