                // to lend it by sharing a color-only table) =================
                [new UnitId(ShapeType.Line, ShapeColor.Yellow)] = BuildTiers(
                    count: 3, costs: new[] { 20, 50 },
                    dmgGrowth: 1.15f, rangeGrowth: 1.05f, intervalShrink: 0.82f),

